<section id="specs">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow center"><span class="dot"></span> The details</div>
      <h2>Full specifications</h2>
    </div>
    <div class="specs-wrap reveal">
      <table class="specs-table">
        <tbody>
          <tr><td>Motor</td><td>High-torque brushless DC</td></tr>
          <tr><td>Speed settings</td><td>3 modes · 150 / 250 / 350 RPM</td></tr>
          <tr><td>Battery</td><td>2200mAh Li-ion, USB-C</td></tr>
          <tr><td>Runtime</td><td>Up to 120 minutes per charge</td></tr>
          <tr><td>Charge time</td><td>~3 hours</td></tr>
          <tr><td>Waterproof rating</td><td>IPX7</td></tr>
          <tr><td>Handle length</td><td>Telescopic, 27–51 in</td></tr>
          <tr><td>Weight</td><td>1.6 lb (0.73 kg)</td></tr>
          <tr><td>Noise level</td><td>&lt; 65 dB</td></tr>
          <tr><td>Brush heads included</td><td>8</td></tr>
        </tbody>
      </table>
      <div>
        <h3>What's in the box</h3>
        <ul class="box-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 1× Vortiq Pro handle unit</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 8× interchangeable brush heads</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 1× telescopic extension pole</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 1× USB-C charging cable</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 1× wall storage mount</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 1× mesh storage bag</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> User guide &amp; 1-year warranty card</li>
        </ul>
        <a href="#pricing" class="btn btn-primary" style="margin-top:8px">Shop Vortiq Pro</a>
      </div>
    </div>
  </div>
</section>

