<section aria-label="Product specifications">
  <div class="container">
    <div class="stats reveal-stagger">
      <div class="stat"><div class="num" data-count="350">0</div><div class="label">Max RPM Spin Power</div></div>
      <div class="stat"><div class="num" data-count="120" data-suffix=" min">0</div><div class="label">Battery Runtime</div></div>
      <div class="stat"><div class="num" data-count="8">0</div><div class="label">Interchangeable Heads</div></div>
      <div class="stat"><div class="num" data-count="7" data-prefix="IPX">0</div><div class="label">Waterproof Rating</div></div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Stats", "settings": [] }
{% endschema %}
