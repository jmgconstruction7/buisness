<section class="cart-page">
  <div class="container">
    <h1>Your cart</h1>
    {% if cart.item_count == 0 %}
      <p style="color:var(--text-dim)">Your cart is empty.</p>
      <a href="{{ routes.root_url }}#pricing" class="btn btn-primary">Shop Vortiq Pro</a>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart-table">
          <thead>
            <tr><th>Item</th><th>Price</th><th>Qty</th><th>Total</th></tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td>
                  <div class="cart-item-info">
                    {% if item.image %}
                      {% assign item_img_height = 100 | divided_by: item.image.aspect_ratio %}
                      <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}" width="100" height="{{ item_img_height }}">
                    {% endif %}
                    <div>
                      <div>{{ item.product.title }}</div>
                      <div style="color:var(--text-faint);font-size:13px">{{ item.variant.title }}</div>
                    </div>
                  </div>
                </td>
                <td>{{ item.price | money }}</td>
                <td><input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" class="cart-qty-input"></td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="cart-summary">
          <div class="cart-total">Subtotal: <strong>{{ cart.total_price | money }}</strong></div>
          <button type="submit" name="update" class="btn btn-ghost">Update Cart</button>
          <button type="submit" name="checkout" class="btn btn-primary">Checkout</button>
        </div>
      </form>
    {% endif %}
  </div>
</section>

<style>
  .cart-page{ padding: 60px 0; }
  .cart-table{ width:100%; border-collapse:collapse; margin: 24px 0; }
  .cart-table th{ text-align:left; padding:12px 8px; border-bottom:1px solid var(--glass-border); color:var(--text-faint); font-size:13px; text-transform:uppercase; }
  .cart-table td{ padding:14px 8px; border-bottom:1px solid var(--glass-border); }
  .cart-item-info{ display:flex; align-items:center; gap:12px; }
  .cart-item-info img{ width:56px; height:56px; object-fit:contain; background:#F3F7FB; border-radius:8px; padding:6px; }
  .cart-qty-input{ width:64px; padding:8px; border-radius:8px; background:var(--bg-soft); border:1px solid var(--glass-border); color:var(--text); }
  .cart-summary{ display:flex; align-items:center; gap:16px; justify-content:flex-end; flex-wrap:wrap; }
  .cart-total{ margin-right:auto; font-size:16px; }
</style>

{% schema %}
{ "name": "Main cart", "settings": [] }
{% endschema %}
