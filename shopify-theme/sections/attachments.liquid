<section id="attachments" style="background:var(--bg-soft)">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow center"><span class="dot"></span> One handle, eight tools</div>
      <h2>A head for every surface in the house</h2>
    </div>
    <div class="attach-grid reveal-stagger">
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-flat.jpg' | asset_url }}" alt="Flat scrubber brush head" loading="lazy" width="227" height="165"></div>
        <h5>Flat Scrubber</h5>
        <span>Tile &amp; floors</span>
      </div>
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-dome.jpg' | asset_url }}" alt="Dome brush head" loading="lazy" width="220" height="167"></div>
        <h5>Dome Brush</h5>
        <span>Wide surfaces</span>
      </div>
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-cone.jpg' | asset_url }}" alt="Cone-shaped detail brush head" loading="lazy" width="135" height="191"></div>
        <h5>Detail Brush</h5>
        <span>Grout &amp; corners</span>
      </div>
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-bristle.jpg' | asset_url }}" alt="Round bristle brush head" loading="lazy" width="152" height="200"></div>
        <h5>Bristle Head</h5>
        <span>Tub &amp; sink</span>
      </div>
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-scour.jpg' | asset_url }}" alt="Green scouring pad" loading="lazy" width="208" height="174"></div>
        <h5>Scouring Pad</h5>
        <span>Tough stains</span>
      </div>
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-buff.jpg' | asset_url }}" alt="White buffing pad" loading="lazy" width="234" height="170"></div>
        <h5>Buffing Pad</h5>
        <span>Polish &amp; shine</span>
      </div>
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-microfiber.jpg' | asset_url }}" alt="Microfiber pad" loading="lazy" width="235" height="143"></div>
        <h5>Microfiber Pad</h5>
        <span>Glass &amp; dusting</span>
      </div>
      <div class="attach-card">
        <div class="attach-icon"><img src="{{ 'pad-sponge.jpg' | asset_url }}" alt="Honeycomb sponge pad" loading="lazy" width="212" height="166"></div>
        <h5>Sponge Pad</h5>
        <span>Car &amp; general wash</span>
      </div>
    </div>
    <p class="center" style="max-width:520px;margin-top:32px;font-size:14px">Plus a telescopic extension pole, wall storage hook, and mesh carry bag — see full contents in <a href="#specs" style="color:var(--cyan-soft);text-decoration:underline">specifications</a>.</p>
  </div>
</section>

{% schema %}
{ "name": "Attachments", "settings": [] }
{% endschema %}
